/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */
/* Half-scale version of rounded-template-hidpi.rasi. */

* {
    font:   "Mononoki Nerd Font 12";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50% - 225px);
    width:          640;
    border-radius:  5px;

    background-color:   @bg0;
}

mainbox {
    padding:    6px;
}

inputbar {
    background-color:   @bg1;
    border-color:       @bg3;

    border:         1.5px;
    border-radius:  4px;

    padding:    4px 8px;
    spacing:    4px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg2;
}

entry {
    placeholder:        "Search";
    placeholder-color:  @fg3;
}

message {
    margin:             6px 0 0;
    border-radius:      5px;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    4px 12px;
}

listview {
    background-color:   transparent;

    margin:     6px 0 0;
    lines:      10;
    columns:    1;

    scrollbar:    true;
    fixed-height: false;
    dynamic:      true;
}

scrollbar {
  handle-width : 2px;
  handle-color : @fg2;
  padding      : 0 0 0 4px;
}

element {
    padding:        4px 8px;
    spacing:        4px;
    border-radius:  5px;
}

element normal active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

element selected normal, element selected active {
    background-color:   @bg3;
}

element-icon {
    size:           2em;
    vertical-align: 0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

element selected {
    text-color: @bg1;
}
